{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "app/globals.css",
    "functions": [
      "cn",
      "cva"
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    ".claude/",
    "public/",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "components/demos/index.ts"
  ]
}
