{
  "$description": "caffeine: design tokens from registry/themes/caffeine.json and registry/tokens.mjs. Sets: core (mode-independent), light, dark. Colors are sRGB hex; the authored value is in $extensions[\"com.renanleonel.ui\"].original.",
  "core": {
    "radius": {
      "base": {
        "$type": "dimension",
        "$value": "0.5rem"
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'"
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "ui-serif, Georgia, Cambria, \"Times New Roman\", Times, serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      }
    },
    "ds": {
      "radius": {
        "control": {
          "$type": "dimension",
          "$value": "{radius.base}",
          "$extensions": {
            "com.renanleonel.ui": {
              "original": "var(--radius)"
            }
          }
        }
      },
      "panel": {
        "radius": {
          "$type": "dimension",
          "$value": "{radius.base} * 2.4",
          "$extensions": {
            "com.renanleonel.ui": {
              "original": "calc(var(--radius) * 2.4)"
            }
          }
        },
        "pad": {
          "$type": "dimension",
          "$value": "0.5rem"
        }
      },
      "control": {
        "height": {
          "$type": "dimension",
          "$value": "2rem"
        },
        "height-sm": {
          "$type": "dimension",
          "$value": "1.75rem"
        },
        "height-xs": {
          "$type": "dimension",
          "$value": "1.5rem"
        },
        "height-lg": {
          "$type": "dimension",
          "$value": "2.25rem"
        }
      },
      "ease": {
        "out": {
          "$type": "cubicBezier",
          "$value": [
            0.23,
            1,
            0.32,
            1
          ],
          "$extensions": {
            "com.renanleonel.ui": {
              "original": "cubic-bezier(0.23, 1, 0.32, 1)"
            }
          }
        },
        "in-out": {
          "$type": "cubicBezier",
          "$value": [
            0.77,
            0,
            0.175,
            1
          ],
          "$extensions": {
            "com.renanleonel.ui": {
              "original": "cubic-bezier(0.77, 0, 0.175, 1)"
            }
          }
        },
        "drawer": {
          "$type": "cubicBezier",
          "$value": [
            0.32,
            0.72,
            0,
            1
          ],
          "$extensions": {
            "com.renanleonel.ui": {
              "original": "cubic-bezier(0.32, 0.72, 0, 1)"
            }
          }
        }
      },
      "duration": {
        "press": {
          "$type": "duration",
          "$value": "160ms"
        },
        "tooltip": {
          "$type": "duration",
          "$value": "125ms"
        },
        "popover": {
          "$type": "duration",
          "$value": "200ms"
        },
        "modal": {
          "$type": "duration",
          "$value": "250ms"
        },
        "drawer": {
          "$type": "duration",
          "$value": "500ms"
        }
      }
    }
  },
